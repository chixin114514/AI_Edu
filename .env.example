PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/manxing.sqlite
# Set live to use actual map/weather services. Demo never fabricates live data.
DATA_MODE=demo
# Uses the same key variable as the supplied Amap MCP. Legacy AMAP_KEY also supported.
AMAP_MAPS_API_KEY=
# Minimum interval between uncached map reads; tune to the account QPS quota.
AMAP_MIN_INTERVAL_MS=1100
QWEATHER_API_KEY=
QWEATHER_API_BASE=https://your-host.re.qweatherapi.com
# v1 recommended; v7 supports older city-based subscriptions.
QWEATHER_API_VERSION=v1
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_DEFAULT_MODEL=jev-1.13.0
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional legacy gateway only if TYPESAFE_API_KEY is absent.
JEV_GATEWAY_URL=
JEV_API_KEY=
# Official meituan-travel Skill token; kept on server only.
MEITUAN_HT_TOKEN=
ADMIN_TOKEN=
COOKIE_SECURE=false

# Optional local HTTP CONNECT proxy; leave blank when direct access is available.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
NODE_USE_ENV_PROXY=1
